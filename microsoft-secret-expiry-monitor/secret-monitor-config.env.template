# Microsoft Secret Key Expiration Monitor Configuration
# Copy this file to secret-monitor-config.env and fill in your values

# Azure AD Configuration
# Get these values from your Azure AD app registration
TENANT_ID="your-tenant-id-here"
CLIENT_ID="your-client-id-here"
CLIENT_SECRET="your-client-secret-here"

# Email Configuration
# SMTP settings for sending notifications
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="your-smtp-username@domain.com"
SMTP_PASSWORD="your-smtp-password-or-app-password"

# Notification Settings
NOTIFICATION_EMAIL="admin@yourdomain.com"
FROM_EMAIL="noreply@yourdomain.com"

# Optional: Custom alert thresholds (days before expiration)
# Default is 30, 7, 3 days if not specified
# ALERT_THRESHOLDS="30 14 7 3 1"

# Cron Job Configuration
# Enable/disable automatic cron job setup (true/false)
ENABLE_CRON="true"

# Cron schedule for automated monitoring
# Default: "0 9 * * *" (daily at 9:00 AM)
# Examples:
#   "0 9 * * *"     - Daily at 9:00 AM
#   "0 18 * * *"    - Daily at 6:00 PM
#   "0 9,18 * * *"  - Twice daily (9:00 AM and 6:00 PM)
#   "0 9 * * 1-5"   - Weekdays only at 9:00 AM
CRON_SCHEDULE="0 9 * * *"